{
  "providers": [
    {
      "name": "openrouter",
      "label": "OpenRouter",
      "base_url": "https://openrouter.ai/api",
      "models_path": "/v1/models",
      "env_keys": ["OPENROUTER_API_KEY"],
      "mapping": {
        "list": "data",
        "id": "id",
        "name": "name",
        "context": "context_length",
        "prompt_price": "pricing.prompt",
        "completion_price": "pricing.completion"
      },
      "completions": {
        "path": "/v1/chat/completions",
        "auth_header": "Authorization",
        "auth_prefix": "Bearer ",
        "body": "{\"model\":\"{{.Model}}\",\"messages\":[{\"role\":\"user\",\"content\":\"{{.Prompt}}\"}],\"max_tokens\":1,\"temperature\":0}",
        "usage": "usage.total_tokens"
      }
    },
    {
      "name": "kilocode",
      "label": "Kilo Code",
      "base_url": "https://api.kilo.ai/api/gateway",
      "models_path": "/models",
      "env_keys": ["KILOCODE_API_KEY", "KILO_API_KEY"],
      "mapping": {
        "list": "data",
        "id": "id",
        "name": "name",
        "context": "context_length",
        "prompt_price": "pricing.prompt",
        "completion_price": "pricing.completion"
      },
      "completions": {
        "path": "/chat/completions",
        "auth_header": "Authorization",
        "auth_prefix": "Bearer ",
        "body": "{\"model\":\"{{.Model}}\",\"messages\":[{\"role\":\"user\",\"content\":\"{{.Prompt}}\"}],\"max_tokens\":1,\"temperature\":0}",
        "usage": "usage.total_tokens"
      }
    },
    {
      "name": "cline",
      "label": "Cline",
      "base_url": "https://api.cline.bot/api/v1",
      "models_path": "/models",
      "env_keys": ["CLINE_API_KEY"],
      "mapping": {
        "list": "data",
        "id": "id",
        "name": "id",
        "prompt_price": "",
        "completion_price": ""
      },
      "completions": {
        "path": "/chat/completions",
        "auth_header": "Authorization",
        "auth_prefix": "Bearer ",
        "body": "{\"model\":\"{{.Model}}\",\"messages\":[{\"role\":\"user\",\"content\":\"{{.Prompt}}\"}],\"max_tokens\":1}",
        "usage": "usage.total_tokens"
      }
    },
    {
      "name": "opencode-zen",
      "label": "OpenCode Zen",
      "base_url": "https://opencode.ai/zen/v1",
      "models_path": "/models",
      "env_keys": ["OPENCODE_API_KEY"],
      "mapping": {
        "list": "data",
        "id": "id",
        "name": "id",
        "prompt_price": "",
        "completion_price": ""
      },
      "free_ids": [
        "big-pickle",
